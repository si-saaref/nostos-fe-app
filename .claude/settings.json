{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Bash(cat **/.env)",
      "Bash(cat **/.env.local)",
      "Bash(cat **/.env.development)",
      "Bash(cat **/.env.production)",
      "Bash(grep * .env)",
      "Bash(grep * .env.local)",
      "Bash(grep * .env.development)",
      "Bash(grep * .env.production)"
    ],
    "allow": [
      "Read(//Volumes/BigBrain/Household/**)",
      "Bash(docker *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(grep *)",
      "Bash(tar *)"
    ]
  }
}
