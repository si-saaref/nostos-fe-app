# API base URL for the NestJS backend. Leave unset in dev to use the MSW mock layer.
VITE_API_URL=http://localhost:3073
# Set to "false" to disable the MSW mock worker in dev.
VITE_ENABLE_MOCKS=true
# Set to "true" to also mock the auth API. Off by default: auth has shipped, so
# signin runs against the real backend at VITE_API_URL.
VITE_MOCK_AUTH=false
