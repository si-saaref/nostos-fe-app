# API base URL for the NestJS backend.
VITE_API_URL=http://localhost:3073
# The only mock switch: "false" turns the MSW worker off entirely, so every
# request goes to VITE_API_URL. WHICH modules are mocked is declared in code,
# in src/mocks/handlers/index.ts — see MOCKED there.
VITE_ENABLE_MOCKS=true
